{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^sonarqube/values\\.yaml$/"],
      "matchStrings": ["https://github\\.com/dependency-check/dependency-check-sonar-plugin/releases/download/(?<currentValue>[^/]+)/sonar-dependency-check-plugin-[^/]+\\.jar", "https://github\\.com/spotbugs/sonar-findbugs/releases/download/(?<currentValue>[^/]+)/sonar-findbugs-plugin-[^/]+\\.jar", "https://github\\.com/sbaudoin/sonar-yaml/releases/download/v(?<currentValue>[^/]+)/sonar-yaml-plugin-[^/]+\\.jar", "https://github\\.com/sonargraph/sonar-sonargraph-integration/releases/download/(?<currentValue>[^/]+)/sonar-sonargraph-integration-[^/]+\\.jar"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "sonarqube-plugin-{{depName}}",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "groupName": "all patch dependencies",
      "groupSlug": "all-patch",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "schedule": ["after 10pm on Monday, Tuesday, Wednesday, Thursday",  "before 5am on Monday, Tuesday, Wednesday, Thursday"],
      "labels": ["dependencies", "patch"],
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "groupName": "all minor dependencies",
      "groupSlug": "all-minors",
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "schedule": ["after 10pm on Monday, Tuesday, Wednesday, Thursday",  "before 5am on Monday, Tuesday, Wednesday, Thursday"],
      "labels": ["dependencies", "minor"],
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "groupName": "all major dependencies",
      "groupSlug": "all-majors",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"],
      "minimumReleaseAge": "7 days",
      "matchPackageNames": [
        "*"
      ]
    }
  ],
  "automergeType": "branch",
  "automerge": true,
  "ignoreTests": true,
  "dependencyDashboard": true,
  "timezone": "Europe/London"
}

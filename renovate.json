{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "regexManagers": [
    {
      "fileMatch": ["^sonarqube/values\\.yaml$"],
      "matchStrings": [
        "https://github\\.com/dependency-check/dependency-check-sonar-plugin/releases/download/(?<currentValue>[^/]+)/sonar-dependency-check-plugin-(?<currentValue>[^/]+)\\.jar",
        "https://github\\.com/spotbugs/sonar-findbugs/releases/download/(?<currentValue>[^/]+)/sonar-findbugs-plugin-(?<currentValue>[^/]+)\\.jar",
        "https://github\\.com/sbaudoin/sonar-yaml/releases/download/v(?<currentValue>[^/]+)/sonar-yaml-plugin-(?<currentValue>[^/]+)\\.jar",
        "https://github\\.com/sonargraph/sonar-sonargraph-integration/releases/download/(?<currentValue>[^/]+)/sonar-sonargraph-integration-(?<currentValue>[^/]+)\\.jar"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "groupName": "all patch dependencies",
      "groupSlug": "all-patch",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "schedule": ["after 10pm and before 5am on Monday, Tuesday, Wednesday, Thursday"],
      "labels": ["dependencies", "patch"]
    },
    {
      "groupName": "all minor dependencies",
      "groupSlug": "all-minors",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "schedule": ["after 10pm and before 5am on Monday, Tuesday, Wednesday, Thursday"],
      "labels": ["dependencies", "minor"]
    },
    {
      "groupName": "all major dependencies",
      "groupSlug": "all-majors",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"],
      "minimumReleaseAge": "7 days"
    }
  ],
  "automergeType": "branch",
  "automerge": true,
  "requiredStatusChecks": null,
  "dependencyDashboard": true,
  "timezone": "Europe/London"
}
